From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Yoshi Sugawara <yoshi.sugawara@gmail.com>
Date: Thu, 29 Oct 2026 07:52:24 -1000
Subject: [PATCH] shader split: shader code archives of the layout before
 version 2 in legacy paks (Bloodstained: Ritual of the Night)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

Upstream-Status: pending
Reason: Bloodstained: Ritual of the Night keeps its shaders in a pre-version-2 ShaderArchive inside a version 4 pak; the shader split found none
Issue: none yet (Bloodstained: Ritual of the Night bring-up)

---
 dm/gfx/tools/shader_split.py | 23 ++++++++++++++++++++++-
 dm/gfx/tools/uepak.py        | 11 +++++++++++
 2 files changed, 33 insertions(+), 1 deletion(-)

diff --git a/dm/gfx/tools/shader_split.py b/dm/gfx/tools/shader_split.py
index 6707aa97..155d50e3 100644
--- a/dm/gfx/tools/shader_split.py
+++ b/dm/gfx/tools/shader_split.py
@@ -1583,7 +1583,28 @@ def ue_legacy_shaders(path, rel, names, out):
     for name in names:
         d = pk.read(name, decode=oodle)
         label = re.sub(r"^(\.\./)+", "", os.path.normpath(pk.mount + name))
-        ue_inline_shaders(d, f'/{rel}#{label}', out)
+        if name.endswith('.ushaderbytecode'): ue_archive_v1_shaders(d, f'/{rel}#{label}', out)
+        else: ue_inline_shaders(d, f'/{rel}#{label}', out)
+
+def ue_archive_v1_shaders(d, label, out):
+    """A shader code archive of the layout before version 2 in a legacy pak (uepak.archive_v1; Bloodstained: Ritual of the Night keeps all its material shaders there, bShareMaterialShaderCode on
+    with UE 4.18's pak): each shader is an LSLG record, zlib-compressed when its stored size is below its raw size; the stage is the record's tag"""
+    import zlib
+    ents = uepak.archive_v1(d)
+    if ents is None: red(f'{label}: a shader code archive of neither version 2 nor the earlier layout (uepak.archive_v1)')
+    for i, (off, size, raw) in enumerate(ents):
+        s = d[off:off + size]
+        if size != raw:
+            try: s = zlib.decompress(s)
+            except zlib.error as e: red(f'{label}: shader {i} does not inflate ({e})')
+        if len(s) != raw: red(f'{label}: shader {i} inflates to {len(s)} bytes, the table says {raw}')
+        rec = uepak.lslg(s)
+        if not rec: red(f'{label}: shader {i} is not an LSLG record')
+        tag, ctl, code = rec; st = UE_TAG.get(tag)
+        if not st: red(f'{label}: shader {i} has stage tag {tag}')
+        why = check(label, st, ctl, code)
+        if why: red(f'{label}: shader {i} ({st}): {why}')
+        out.append((f'{label}#UE{i}', st, ctl, code))
 
 ZLIB_HEAD = re.compile(b'\x78[\x01\x5e\x9c\xda]')
 def ue_inline_shaders(d, label, out):
diff --git a/dm/gfx/tools/uepak.py b/dm/gfx/tools/uepak.py
index edb9974f..af651405 100644
--- a/dm/gfx/tools/uepak.py
+++ b/dm/gfx/tools/uepak.py
@@ -250,6 +250,17 @@ def archive(b):
     n = r.take('<I'); indices = list(struct.unpack_from(f'<{n}I', b, r.o)); r.o += 4 * n
     return dict(maps=maps, shaders=shaders, indices=indices, code=r.o)
 
+def archive_v1(b):
+    """A shader code archive from before the versioned layout (Bloodstained: Ritual of the Night, a legacy version 4 pak: Content/ShaderArchive-GLSL_SWITCH.ushaderbytecode, 27,086 shaders):
+    u32 entry count, then per entry the shader's SHA-1 (20 bytes), its offset from the end of the table, stored size and raw size (u32 each), then the code. A shader stored smaller than its
+    raw size is one zlib stream. There is no frequency: the LSLG record's tag gives the stage. → [(offset from the start of b, stored size, raw size)], or None when b is not this layout"""
+    if len(b) < 4: return None
+    n = struct.unpack_from('<I', b, 0)[0]; base = 4 + 32 * n
+    if not n or base > len(b): return None
+    ents = [struct.unpack_from('<III', b, 4 + 32 * i + 20) for i in range(n)]
+    if max(o + s for o, s, _ in ents) != len(b) - base or any(s > r for _, s, r in ents): return None
+    return [(base + o, s, r) for o, s, r in ents]
+
 def decoded_archive(b, raws):
     """The archive with every shader replaced by its decoded bytes (raws, in entry order): the same tables, each entry's size = its raw size, the code laid out again
     (the preload entries keep their old file ranges; only the shader tools read these copies)"""
